@page
@model IndexModel
@{
    ViewData["Title"] = "CHRILLEMON 🇮🇹 GENERATORE — Mamma Mia Edition";
}

<div class="chrillemon-page py-3">

    <div id="pizzaLoader" class="pizza-loader" style="display:none;" aria-live="polite" aria-busy="true">
        <div class="pizza-loader-content">
            <div class="pizza-spinner">🍕</div>
            <div class="bipidi-text" aria-label="bi pi di ba pi di bo">
                <span>b</span><span>i</span><span>&nbsp;</span><span>p</span><span>i</span><span>&nbsp;</span><span>d</span><span>i</span><span>&nbsp;</span><span>b</span><span>a</span><span>&nbsp;</span><span>p</span><span>i</span><span>&nbsp;</span><span>d</span><span>i</span><span>&nbsp;</span><span>b</span><span>o</span>
            </div>
            <div class="loader-sub">Nonna snurrar degen… 🤌✨</div>
            <div class="loader-hint small">Det tar 10-20 sek — LLM bakar din Chrillemon i vedugnen</div>
        </div>
    </div>

    <div class="no-print d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="italian-ticker">
            <span class="fs-5">🤌</span>
            <span id="nonnaQuoteText">“MAMMA MIA! Vilken Chrillemon, perfetto!” 🍝✨</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-light rounded-pill px-3 fw-bold shadow-sm" onclick="togglePastaMode()">
                <span id="pastaBadge">🍝 PASTA-MODE: OFF</span>
            </button>
            <button type="button" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold shadow-sm" onclick="launchPastaConfetti()">
                🎉 MAMMA MIA CONFETTI!
            </button>
        </div>
    </div>

    <div class="tricolore-bar mb-4"></div>

    <div class="no-print text-center mb-4 position-relative">
        <div class="floating-pasta" aria-hidden="true">🍝 🍕 🫒 🛵 🏛️ 🍝 🍅</div>
        <h1 class="chrillemon-title mb-1">
            <span class="title-italian-green">CHRILLE</span><span class="title-italian-white">MON</span><span class="title-italian-red"> GENERATORE</span>
            <span class="d-block fs-5 mt-1 fw-bold" style="letter-spacing: 4px; color:#ffd700; text-shadow: 0 0 12px #ff0000;">🇮🇹 MAMMA MIA EDITION 🇮🇹</span>
        </h1>
        <p class="chrillemon-subtitle mt-2">
            Skapa din egen <strong>Chrillemon</strong> — Pokemon fast på italienska, capisce? <br/>
            <span class="badge bg-success">FUOCO</span> <span class="badge bg-primary">ACQUA</span> <span class="badge bg-success" style="background:#4caf50!important">ERBA</span> <span class="badge bg-warning text-dark">ELETTRICO</span> <span class="badge" style="background:#8B4513">TERRA</span> — tutti frutti!
        </p>
        <p class="small fst-italic" style="color:#ffe8b3">Alla Chrillemons <strong>måste</strong> sluta på <code>-ennari</code> & ha italiensk flärd — annars blir Nonna rasande! 🤌🍝</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger border-0 shadow rounded-4 no-print mb-4" style="background: linear-gradient(90deg,#ff3b30,#ff9500); color:white; font-weight:800;">
            <span class="fs-4">🍕</span> @Model.ErrorMessage
        </div>
    }

    <div class="no-print chrillemon-form-card p-4 mb-5">
        <form method="post" asp-page-handler="Generate" id="chrillemonForm">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-5">
                    <label for="chrillemonNamn" class="form-label fw-black text-uppercase" style="color:#00a651; letter-spacing:1px;">
                        🇮🇹 1. Nome della Chrillemon <span class="text-danger">*</span>
                    </label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text" style="background:#008C45; color:white; font-weight:900; border:none;">🤌</span>
                        <input id="chrillemonNamn" name="ChrillemonNamn" value="@Model.ChrillemonNamn" class="form-control chrillemon-input" placeholder="t.ex. Pizzalio / Inferno" required maxlength="40" />
                        <span class="input-group-text" style="background:#CD212A; color:white; font-weight:900; border:none;">ennari</span>
                    </div>
                    <div class="form-text" style="color:#ffe8b3">Skriv utan ändelse — vi lägger till <strong>-ennari</strong> automatiskt! ✨</div>
                </div>
                <div class="col-md-7">
                    <label for="chrillemonBeskrivning" class="form-label fw-black text-uppercase" style="color:#CD212A; letter-spacing:1px;">
                        🍝 2. Descrizione — typ, attacker & vibe <span class="text-danger">*</span>
                    </label>
                    <textarea id="chrillemonBeskrivning" name="ChrillemonBeskrivning" class="form-control chrillemon-textarea p-3" rows="3" placeholder="Ex: Eld-typ, ser ut som en liten Vespa-leopard med pepperoni-fläckar, attacker: 'Espresso Shot' och 'Mamma's Slap' — snabb och kryddig!" required>@Model.ChrillemonBeskrivning</textarea>
                </div>
            </div>

            <div class="mt-4">
                <div class="small fw-black text-uppercase mb-2" style="color:#ffd700; letter-spacing:1px;">⚡ PRESTO! Klicka för snabb-fyllning — vibekodad inspo:</div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn-preset-italian" onclick="fillChrillemon('Pesto','Gräs-typ, liten basilika-gecko med mozzarella-mage, doftar som Liguriens kust, attacker: Foglia Tagliente & Pesto Slap, lugn men farlig')">
                        🌿 Pestennari <small>erba</small>
                    </button>
                    <button type="button" class="btn-preset-italian" onclick="fillChrillemon('Vespario','Elektrisk-typ, Vespa-inspirerad geting med krom-vingar som låter VROOOM, attacker: Spark Plug & Tuono Scossa, blixtsnabb i Rom-trafiken')">
                        🛵 Vespariennari <small>elettro</small>
                    </button>
                    <button type="button" class="btn-preset-italian" onclick="fillChrillemon('Gondolio','Vatten-typ, gondol-groda med gondol-hatt och Venedig-ränder, attacker: Aqua Spruzzo & Canale Wave, glider fram i kanalerna')">
                        💧 Gondolennari <small>acqua</small>
                    </button>
                    <button type="button" class="btn-preset-italian" onclick="fillChrillemon('Inferno','Eld-typ, vulkan-kat med Etna-rök ur öronen, pizza-mönster på pälsen, attacker: Espresso Inferno & Pepperoncino Burn, het som en vedugn i Napoli')">
                        🔥 Infernoennari <small>fuoco</small>
                    </button>
                    <button type="button" class="btn-preset-italian" onclick="fillChrillemon('Colosso','Sten-typ, Colosseum-sköldpadda med marmor-pelare på ryggen, attacker: Marmo Smash & Gladiatore Roar, tung som historia')">
                        🏛️ Colossennari <small>roccia</small>
                    </button>
                    <button type="button" class="btn-preset-italian" onclick="fillChrillemon('Nonnano','Psykisk-typ, gammal vis nonna-katt med glasögon och förkläde, attacker: Cucchiaio Wood & Mamma’s Guilt, ser allt, vet allt')">
                        👵 Nonnennari <small>psico</small>
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-4 pt-3 border-top" style="border-color: rgba(255,255,255,0.2)!important">
                <div class="small" style="color:#ffe8b3">💡 Tips: Ju mer italiensk detalj (mat, stad, dialekt) desto bättre bild från AI:n!</div>
                <button type="submit" id="generateBtn" class="btn-genera">
                    <span id="btnText">🤌 GENERA CHRILLEMON! 🇮🇹</span>
                    <span id="btnSpinner" class="spinner-border spinner-border-sm ms-2" style="display:none;"></span>
                </button>
            </div>
        </form>
    </div>

    @if (Model.HasResult)
    {
        <div id="resultCard" class="chrillemon-result-card mb-5">
            <div class="result-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="small fw-bold text-uppercase" style="color:#ffd700; letter-spacing:2px;">✨ IL TUO CHRILLEMON È PRONTO ✨</div>
                    <h2 class="result-name mb-0">@Model.GeneratedName</h2>
                    <div class="mt-1 small fst-italic" style="color:#ffe8b3">"@Model.ChrillemonBeskrivning"</div>
                </div>
                <div class="d-flex gap-2 no-print">
                    <button type="button" class="btn btn-light rounded-pill px-3 fw-bold" onclick="window.print()">🖨️ Stampa Carta</button>
                    <a href="/" class="btn btn-outline-light rounded-pill px-3 fw-bold">🔄 Nuovo</a>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row g-4">
                    <div class="col-lg-6 text-center">
                        <div class="chrillemon-img-frame">
                            <img id="generatedImg" src="@Model.GeneratedImageBase64" alt="@Model.GeneratedName" class="chrillemon-img" />
                        </div>
                        <div class="mt-3">
                            <span class="badge rounded-pill" style="background:#008C45;">🇮🇹 100% Original</span>
                            <span class="badge rounded-pill" style="background:#CD212A;">No copyright — solo Chrillemon!</span>
                        </div>
                        <div class="small mt-2" style="color:#ffe8b3">Genererad via <strong>Azure gpt-image-1.5</strong> med stilprompt 🤌</div>
                    </div>

                    <div class="col-lg-6">
                        <div class="info-box mb-3">
                            <h5 class="fw-black" style="color:#008C45;">📛 Nome</h5>
                            <p class="fs-4 fw-bold mb-0" style="color:#1a1a1a; font-family: 'Georgia', serif; font-style: italic;">@Model.GeneratedName</p>
                            <small class="text-muted">slutar alltid på -ennari — perfekt italiensk!</small>
                        </div>
                        <div class="info-box mb-3">
                            <h5 class="fw-black" style="color:#CD212A;">📜 Descrizione</h5>
                            <p style="white-space: pre-line; color:#333;" class="mb-0">@Model.ChrillemonBeskrivning</p>
                        </div>
                        <div class="info-box" style="background: #fff8e1; border-color: #ffd700;">
                            <h5 class="fw-black" style="color:#8B4513;">🍝 La Storia — Nonnas visdom</h5>
                            <p class="small fst-italic mb-0" style="color:#5d4037;">"Questo Chrillemon è nato nelle cucina di Nonna i Toscana — impastato con amore, kryddat med kaos och bakat i vedugn. Tratta den väl, annars kommer Nonnas slev! 🥄"</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.GeneratedPromptDebug))
                        {
                            <details class="mt-3">
                                <summary class="small fw-bold" style="cursor:pointer; color:#008C45;">🔍 Visa full prompt som skickades till AI:n</summary>
                                <pre class="mt-2 p-3 rounded" style="background:#1a1a1a; color:#ffe8b3; font-size: 0.75rem; white-space: pre-wrap; max-height: 220px; overflow:auto;">@Model.GeneratedPromptDebug</pre>
                            </details>
                        }
                    </div>
                </div>
            </div>

            <div class="card-footer text-center small" style="background: linear-gradient(90deg,#008C45,#fff,#CD212A); color:#1a1a1a; font-weight:800; letter-spacing:1px;">
                🇮🇹 CHRILLEMON™ — Tutti i diritti riservati alla Nonna &bull; Stampami e spela! 🃏
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function(){
                const el = document.getElementById("resultCard");
                if(el){ el.scrollIntoView({behavior:'smooth', block:'start'}); if(typeof launchPastaConfetti==='function') launchPastaConfetti(); }
            });
        </script>
    }
    else
    {
        <!-- PLACEHOLDER NÄR INGET GENERERATS ÄN -->
        <div class="text-center p-5 rounded-4 mb-5" style="background: rgba(255,255,255,0.06); border: 2px dashed rgba(255,215,0,0.4);">
            <div class="display-1 mb-2">🃏</div>
            <h4 class="fw-black" style="color:#ffd700;">La tua Chrillemon apparirà qui!</h4>
            <p class="mb-0" style="color:#ffe8b3">Fyll i nome + descrizione ovan och tryck <strong>GENERA</strong> — AI:n målar ditt kort direkt! 🤌✨</p>
        </div>
    }

</div>

@section Scripts {
<script>
    // Visa "bi pi di ba pi di bo" + snurrande pizza vid submit — LLM tar 10-20s
    document.getElementById("chrillemonForm")?.addEventListener("submit", function(){
        const btn = document.getElementById("generateBtn");
        const t = document.getElementById("btnText");
        const s = document.getElementById("btnSpinner");
        const loader = document.getElementById("pizzaLoader");
        if(btn){ btn.disabled = true; }
        if(t){ t.innerHTML = '<span class="bipidi-btn">bi pi di ba pi di bo</span> <span class="pizza-btn-spin">🍕</span>'; }
        if(s){ s.style.display = "none"; }
        if(loader){ loader.style.display = "flex"; }
        // Förhindra extra scroll medan overlay visas
        document.body.style.overflow = "hidden";
    });
</script>
}
